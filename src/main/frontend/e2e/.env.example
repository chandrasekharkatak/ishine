# Copy to frontend root as `.env.e2e` (gitignored) or export these in your shell before `npm run e2e`.
# Never commit real passwords or OTP secrets.

# Angular dev server (default http://localhost:4200)
E2E_BASE_URL=http://localhost:4200

# Required for authenticated flows (timesheet CRUD, navigation after login)
E2E_USERNAME=raj.kumar@apmosysuat1.com
E2E_PASSWORD=Apmosys@123

# If your org uses OTP after password, set a valid one-time code path:
# - Prefer a test account with OTP disabled in lower envs, or
# - Supply a fresh OTP when running headed: E2E_OTP=123456 npm run e2e:headed
E2E_OTP=12341234

# Optional: enable destructive / data-dependent tests (default off)
# E2E_SUBMIT_TIMESHEET=1
# E2E_PROJECT_SEARCH_TEXT=YourProjectName
