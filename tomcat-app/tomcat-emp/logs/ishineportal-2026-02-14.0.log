        GROUP BY emp_id, project_id, employee_team_map_id
    ),

    Employee_Document_Summary AS (
        SELECT DISTINCT
            emp_id, project_id, employee_team_map_id,
            COUNT(DISTINCT CASE
                WHEN UPPER(client_approval_status) = 'APPROVED' AND final_flag = 1
                THEN timesheet_id END) AS approved_days,
            COUNT(DISTINCT CASE
                WHEN UPPER(client_approval_status) = 'PENDING'
                 AND NOT EXISTS (
                     SELECT 1
                     FROM timesheet_document_details
                     WHERE timesheet_id = edsd.timesheet_id
                       AND UPPER(client_approval_status) = 'APPROVED'
                 )
                THEN timesheet_id END) AS pending_days
        FROM Employee_Document_Summary_Details edsd
        GROUP BY emp_id, project_id, employee_team_map_id
    ),

    Daily_Status_Details AS (
        SELECT DISTINCT
            bpe.emp_id, bpe.project_id, bpe.employee_team_map_id,
            adir.dt AS timesheet_date,
            global_ts.client_in_time, global_ts.client_out_time, global_ts.shadow_emp_id,
            CASE
                WHEN adir.dt NOT IN (SELECT date FROM employee_timesheets_new et WHERE et.emp_id = bpe.emp_id)
                     AND (adir.dt <= bpe.end_date AND adir.dt >= bpe.start_date) THEN 'A'
                WHEN adir.dt NOT IN (SELECT date FROM employee_timesheets_new et WHERE et.emp_id = bpe.emp_id)
                     AND (bpe.end_date IS NULL AND adir.dt >= bpe.start_date) THEN 'A'
                WHEN UPPER(global_ts_day.day_type) LIKE '%WEEK%OFF%' THEN 'WO'
                WHEN UPPER(global_ts_day.day_type) LIKE '%PUBLIC HOLIDAY%' THEN 'AH'
                WHEN UPPER(global_ts_day.day_type) LIKE '%CLIENT HOLIDAY%' THEN 'CH'
                WHEN UPPER(global_ts_day.day_type) LIKE '%LEAVE%' THEN 'L'
                WHEN (
                        ts_data_all_employee.timesheet_id IS NOT NULL
                        AND (ts_data_relevant.timesheet_id IS NULL OR bpe.employee_team_map_id != ts_data_relevant.employee_team_map_id)
                     ) THEN 'O'
                WHEN doc_approved.timesheet_id IS NOT NULL THEN 'CA'
                WHEN doc_pending.timesheet_id IS NOT NULL THEN 'CN'
                WHEN ts_data_relevant.timesheet_id IS NOT NULL THEN 'P'
                ELSE 'NA'
            END AS daily_status
        FROM Base_Project_Employees bpe
        CROSS JOIN All_Dates_In_Range adir

