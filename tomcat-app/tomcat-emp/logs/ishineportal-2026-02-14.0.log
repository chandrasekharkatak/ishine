                        - (COALESCE(eds.approved_days, 0) + COALESCE(eds.pending_days, 0))
                    ) >= 1 THEN 'Pending'
                ELSE 'Approved'
            END AS employee_status
        FROM Base_Project_Employees bpe
        LEFT JOIN WorkingDays_Summary wds
            ON bpe.employee_team_map_id = wds.employee_team_map_id
        LEFT JOIN Employee_Document_Summary eds
            ON bpe.employee_team_map_id = eds.employee_team_map_id
    )

