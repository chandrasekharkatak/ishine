        UNION
        SELECT DISTINCT emp_id, project_id, employee_team_map_id, dt
        FROM Actual_Client_Side_Submissions
    ),

    WorkingDays_Summary AS (
        SELECT DISTINCT emp_id, project_id, employee_team_map_id, COUNT(DISTINCT dt) AS expected_fill_count
        FROM Combined_Expected_Client_Side_DSR
        GROUP BY emp_id, project_id, employee_team_map_id
    ),

    Employee_Document_Summary AS (
        SELECT DISTINCT
            emp_id, project_id, employee_team_map_id,
