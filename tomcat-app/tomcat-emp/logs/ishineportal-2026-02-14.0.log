    /* ===================== NEW TABLE RELATED CHANGES START ===================== */

    Day_Type_Map AS (
        SELECT day_type_id, day_type
        FROM day_type_master_new
        WHERE is_active = 1
    ),

    /* Timesheet base now from employee_timesheets_new + activities_mapping_new
       and day_type resolved using day_type_master_new. */
    Timesheet_Base_Data AS (
        SELECT DISTINCT
            et.timesheet_id,
            et.emp_id,
            t.project_id,
            etm.employee_team_map_id,
            et.date,
            dtm.day_type AS day_type,
            et.client_in_time,
            et.client_out_time,
            et.shadow_emp_id,
            t.team_id AS team_id,
            a.team_id AS a_team_id
        FROM employee_timesheets_new et
        LEFT JOIN Day_Type_Map dtm ON et.day_type_id = dtm.day_type_id
        LEFT JOIN employee_timesheet_activities_mapping_new etam
            ON et.timesheet_id = etam.timesheet_id
        LEFT JOIN activities a
            ON etam.activity_id = a.activity_id
        LEFT JOIN teams t
            ON a.team_id = t.team_id
        LEFT JOIN employee_team_mapping etm
            ON et.emp_id = etm.emp_id
           AND etm.team_id = t.team_id
           AND et.date >= DATE(etm.start_date)
           AND (etm.end_date IS NULL OR et.date <= DATE(etm.end_date))
        WHERE et.date BETWEEN (SELECT from_date FROM Date_Parameters) AND (SELECT to_date FROM Date_Parameters)
    ),

    /* For leave/holiday/weekoff exclusion, use employee_timesheets_new + resolved day_type text */
    Expected_Client_Side_Base_DSR AS (
        SELECT DISTINCT
            bpe.emp_id, bpe.employee_team_map_id, bpe.project_id, adir.dt
        FROM Base_Project_Employees bpe
        CROSS JOIN All_Dates_In_Range adir
        WHERE adir.dt BETWEEN DATE(bpe.start_date)
                          AND COALESCE(DATE(bpe.end_date), (SELECT to_date FROM Date_Parameters))
          AND adir.dt >= (SELECT from_date FROM Date_Parameters)
          AND NOT EXISTS (
              SELECT 1
              FROM employee_timesheets_new et1
              LEFT JOIN Day_Type_Map dtm1 ON et1.day_type_id = dtm1.day_type_id
              WHERE et1.emp_id = bpe.emp_id
                AND adir.dt = et1.date
                AND UPPER(dtm1.day_type) IN ('LEAVE', 'CLIENT HOLIDAY', 'PUBLIC HOLIDAY', 'WEEK OFF')
          )
    ),

    /* ===================== NEW TABLE RELATED CHANGES END ===================== */

    Employee_Document_Summary_Details AS (
        SELECT DISTINCT
            tbd.emp_id, tbd.project_id, tbd.employee_team_map_id,
            DATE(tbd.date) AS timesheet_date,
            tdd.client_approval_status, tdd.final_flag, tdd.active,
            tbd.shadow_emp_id, tdd.timesheet_id
        FROM timesheet_document_details tdd
        INNER JOIN Timesheet_Base_Data tbd
            ON tdd.timesheet_id = tbd.timesheet_id
           AND tbd.emp_id = tdd.emp_id
        WHERE tdd.active = TRUE
    ),

    Actual_Client_Side_Submissions AS (
        SELECT DISTINCT emp_id, project_id, employee_team_map_id, timesheet_date AS dt
        FROM Employee_Document_Summary_Details tdd
        WHERE (
                (UPPER(tdd.client_approval_status) = 'APPROVED' AND tdd.final_flag = 1)
                OR (
                    UPPER(tdd.client_approval_status) = 'PENDING'
                    AND tdd.timesheet_id NOT IN (
                        SELECT timesheet_id
                        FROM timesheet_document_details
                        WHERE UPPER(client_approval_status) = 'APPROVED'
                    )
                )
              )
          AND tdd.timesheet_date <= (SELECT to_date FROM Date_Parameters)
          AND tdd.timesheet_date >= (SELECT from_date FROM Date_Parameters)
          AND timesheet_date < CURDATE()
    ),

    Combined_Expected_Client_Side_DSR AS (
        SELECT DISTINCT emp_id, project_id, employee_team_map_id, dt
        FROM Expected_Client_Side_Base_DSR
        UNION
        SELECT DISTINCT emp_id, project_id, employee_team_map_id, dt
        FROM Actual_Client_Side_Submissions
    ),

    WorkingDays_Summary AS (
        SELECT DISTINCT emp_id, project_id, employee_team_map_id, COUNT(DISTINCT dt) AS expected_fill_count
        FROM Combined_Expected_Client_Side_DSR
        GROUP BY emp_id, project_id, employee_team_map_id
    ),

    Employee_Document_Summary AS (
        SELECT DISTINCT
            emp_id, project_id, employee_team_map_id,
            COUNT(DISTINCT CASE
                WHEN UPPER(client_approval_status) = 'APPROVED' AND final_flag = 1
                THEN timesheet_id END) AS approved_days,
            COUNT(DISTINCT CASE
                WHEN UPPER(client_approval_status) = 'PENDING'
                 AND NOT EXISTS (
                     SELECT 1
                     FROM timesheet_document_details
                     WHERE timesheet_id = edsd.timesheet_id
                       AND UPPER(client_approval_status) = 'APPROVED'
                 )
                THEN timesheet_id END) AS pending_days
        FROM Employee_Document_Summary_Details edsd
        GROUP BY emp_id, project_id, employee_team_map_id
    ),

    Daily_Status_Details AS (
        SELECT DISTINCT
            bpe.emp_id, bpe.project_id, bpe.employee_team_map_id,
            adir.dt AS timesheet_date,
            global_ts.client_in_time, global_ts.client_out_time, global_ts.shadow_emp_id,
            CASE
                WHEN adir.dt NOT IN (SELECT date FROM employee_timesheets_new et WHERE et.emp_id = bpe.emp_id)
                     AND (adir.dt <= bpe.end_date AND adir.dt >= bpe.start_date) THEN 'A'
                WHEN adir.dt NOT IN (SELECT date FROM employee_timesheets_new et WHERE et.emp_id = bpe.emp_id)
                     AND (bpe.end_date IS NULL AND adir.dt >= bpe.start_date) THEN 'A'
                WHEN UPPER(global_ts_day.day_type) LIKE '%WEEK%OFF%' THEN 'WO'
                WHEN UPPER(global_ts_day.day_type) LIKE '%PUBLIC HOLIDAY%' THEN 'AH'
                WHEN UPPER(global_ts_day.day_type) LIKE '%CLIENT HOLIDAY%' THEN 'CH'
                WHEN UPPER(global_ts_day.day_type) LIKE '%LEAVE%' THEN 'L'
                WHEN (
                        ts_data_all_employee.timesheet_id IS NOT NULL
                        AND (ts_data_relevant.timesheet_id IS NULL OR bpe.employee_team_map_id != ts_data_relevant.employee_team_map_id)
                     ) THEN 'O'
                WHEN doc_approved.timesheet_id IS NOT NULL THEN 'CA'
                WHEN doc_pending.timesheet_id IS NOT NULL THEN 'CN'
                WHEN ts_data_relevant.timesheet_id IS NOT NULL THEN 'P'
                ELSE 'NA'
            END AS daily_status
        FROM Base_Project_Employees bpe
        CROSS JOIN All_Dates_In_Range adir

        /* global timesheet now from employee_timesheets_new */
        LEFT JOIN employee_timesheets_new global_ts
            ON bpe.emp_id = global_ts.emp_id
           AND adir.dt = global_ts.date
        LEFT JOIN Day_Type_Map global_ts_day
            ON global_ts.day_type_id = global_ts_day.day_type_id

        LEFT JOIN Timesheet_Base_Data ts_data_relevant
            ON bpe.emp_id = ts_data_relevant.emp_id
           AND adir.dt = ts_data_relevant.date
           AND bpe.employee_team_map_id = ts_data_relevant.employee_team_map_id

        LEFT JOIN Timesheet_Base_Data ts_data_all_employee
            ON bpe.emp_id = ts_data_all_employee.emp_id
           AND adir.dt = ts_data_all_employee.date

        LEFT JOIN Employee_Document_Summary_Details doc_approved
            ON ts_data_relevant.timesheet_id = doc_approved.timesheet_id
           AND UPPER(doc_approved.client_approval_status) = 'APPROVED'
           AND doc_approved.final_flag = 1
           AND bpe.employee_team_map_id = doc_approved.employee_team_map_id

        LEFT JOIN Employee_Document_Summary_Details doc_pending
            ON ts_data_relevant.timesheet_id = doc_pending.timesheet_id
           AND UPPER(doc_pending.client_approval_status) = 'PENDING'
           AND NOT EXISTS (
               SELECT 1
               FROM timesheet_document_details
               WHERE timesheet_id = doc_pending.timesheet_id
                 AND UPPER(client_approval_status) = 'APPROVED'
           )
           AND bpe.employee_team_map_id = doc_pending.employee_team_map_id
    ),

    Employee_Calculated_Status AS (
        SELECT
            bpe.emp_id, bpe.project_id, bpe.employee_team_map_id,
            COALESCE(wds.expected_fill_count, 0) AS expectedTimesheetFillCount,
            GREATEST(
                0,
                COALESCE(wds.expected_fill_count, 0)
                - (COALESCE(eds.approved_days, 0) + COALESCE(eds.pending_days, 0))
            ) AS client_side_not_filled_count,
            COALESCE(eds.pending_days, 0) AS clientSidePendingCount,
            COALESCE(eds.approved_days, 0) AS clientSideApprovedCount,
            CASE
				WHEN eiwd.expected_ishine_days is null THEN 'Defaulter'\n"                WHEN GREATEST(
                    0,
                    COALESCE(wds.expected_fill_count, 0)
                    - (COALESCE(eds.approved_days, 0) + COALESCE(eds.pending_days, 0))
                ) >= 2 THEN 'Defaulter'
                WHEN COALESCE(eds.pending_days, 0) > 0
                  OR GREATEST(
                        0,
                        COALESCE(wds.expected_fill_count, 0)
                        - (COALESCE(eds.approved_days, 0) + COALESCE(eds.pending_days, 0))
                    ) >= 1 THEN 'Pending'
                ELSE 'Approved'
            END AS employee_status
        FROM Base_Project_Employees bpe
        LEFT JOIN WorkingDays_Summary wds
            ON bpe.employee_team_map_id = wds.employee_team_map_id
        LEFT JOIN Employee_Document_Summary eds
            ON bpe.employee_team_map_id = eds.employee_team_map_id
    )

SELECT *
FROM (
    SELECT DISTINCT bpe.emp_id
