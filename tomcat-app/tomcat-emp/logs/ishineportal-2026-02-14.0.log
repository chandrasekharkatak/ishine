      AND (:projectName IS NULL OR LOWER(bpe.project_name) LIKE CONCAT('%', :projectName, '%'))
      AND (:poNo IS NULL OR LOWER(bpe.po_no) LIKE CONCAT('%', :poNo, '%'))
      AND (:department IS NULL OR LOWER(bpe.dept_name) LIKE CONCAT('%', :department, '%'))
      AND (:clientName IS NULL OR LOWER(bpe.client_name) LIKE CONCAT('%', :clientName, '%'))
      AND (:projectManagers IS NULL OR LOWER(pm.project_manager_name) LIKE CONCAT('%', :projectManagers, '%'))
      AND (:teamName IS NULL OR LOWER(bpe.team_name) LIKE CONCAT('%', :teamName, '%'))
      AND (:employmentStatus IS NULL OR LOWER(bpe.employmentstatus) LIKE CONCAT('%', :employmentStatus, '%'))
      AND (:projectStatus IS NULL OR LOWER(bpe.active) LIKE CONCAT('%', :projectStatus, '%'))
) t
WHERE t.emp_id IN (
    SELECT emp_id
    FROM (
        SELECT
            bpe.emp_id,
            ecs.employee_status
        FROM Base_Project_Employees bpe
        JOIN Employee_Calculated_Status ecs
            ON bpe.employee_team_map_id = ecs.employee_team_map_id
        GROUP BY bpe.emp_id, ecs.employee_status
    ) x
    GROUP BY emp_id
    HAVING COUNT(*) > 1
) 
