            ) AS client_side_not_filled_count,
            COALESCE(eds.pending_days, 0) AS clientSidePendingCount,
            COALESCE(eds.approved_days, 0) AS clientSideApprovedCount,
            CASE
				WHEN eiwd.expected_ishine_days is null THEN 'Defaulter'\n"                WHEN GREATEST(
                    0,
                    COALESCE(wds.expected_fill_count, 0)
