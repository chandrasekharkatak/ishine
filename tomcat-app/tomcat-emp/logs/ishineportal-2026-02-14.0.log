                WHEN doc_approved.timesheet_id IS NOT NULL THEN 'CA'
                WHEN doc_pending.timesheet_id IS NOT NULL THEN 'CN'
                WHEN ts_data_relevant.timesheet_id IS NOT NULL THEN 'P'
                ELSE 'NA'
            END AS daily_status
        FROM Base_Project_Employees bpe
        CROSS JOIN All_Dates_In_Range adir

