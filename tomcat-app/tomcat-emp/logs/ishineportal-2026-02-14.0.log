      AND (:teamName IS NULL OR LOWER(bpe.team_name) LIKE CONCAT('%', :teamName, '%'))
      AND (:employmentStatus IS NULL OR LOWER(bpe.employmentstatus) LIKE CONCAT('%', :employmentStatus, '%'))
