            ) AS client_side_not_filled_count,
            COALESCE(eds.pending_days, 0) AS clientSidePendingCount,
            COALESCE(eds.approved_days, 0) AS clientSideApprovedCount,
            CASE
				WHEN eiwd.expected_ishine_days is null THEN 'Defaulter'\n"                WHEN GREATEST(
                    0,
                    COALESCE(wds.expected_fill_count, 0)
                    - (COALESCE(eds.approved_days, 0) + COALESCE(eds.pending_days, 0))
                ) >= 2 THEN 'Defaulter'
                WHEN COALESCE(eds.pending_days, 0) > 0
                  OR GREATEST(
                        0,
                        COALESCE(wds.expected_fill_count, 0)
                        - (COALESCE(eds.approved_days, 0) + COALESCE(eds.pending_days, 0))
                    ) >= 1 THEN 'Pending'
                ELSE 'Approved'
            END AS employee_status
        FROM Base_Project_Employees bpe
        LEFT JOIN WorkingDays_Summary wds
            ON bpe.employee_team_map_id = wds.employee_team_map_id
        LEFT JOIN Employee_Document_Summary eds
            ON bpe.employee_team_map_id = eds.employee_team_map_id
    )

