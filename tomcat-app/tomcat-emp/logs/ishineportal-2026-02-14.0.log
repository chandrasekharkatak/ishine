            ON global_ts.day_type_id = global_ts_day.day_type_id

        LEFT JOIN Timesheet_Base_Data ts_data_relevant
            ON bpe.emp_id = ts_data_relevant.emp_id
           AND adir.dt = ts_data_relevant.date
           AND bpe.employee_team_map_id = ts_data_relevant.employee_team_map_id

        LEFT JOIN Timesheet_Base_Data ts_data_all_employee
            ON bpe.emp_id = ts_data_all_employee.emp_id
           AND adir.dt = ts_data_all_employee.date

        LEFT JOIN Employee_Document_Summary_Details doc_approved
            ON ts_data_relevant.timesheet_id = doc_approved.timesheet_id
           AND UPPER(doc_approved.client_approval_status) = 'APPROVED'
           AND doc_approved.final_flag = 1
           AND bpe.employee_team_map_id = doc_approved.employee_team_map_id

        LEFT JOIN Employee_Document_Summary_Details doc_pending
            ON ts_data_relevant.timesheet_id = doc_pending.timesheet_id
           AND UPPER(doc_pending.client_approval_status) = 'PENDING'
